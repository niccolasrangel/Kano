{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Kano: dev (live reload)",
      "type": "shell",
      "command": "go tool mygo dev",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Kano: dev em português (pt-BR)",
      "type": "shell",
      "command": "go tool mygo dev -lang pt-BR",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Kano: build",
      "type": "shell",
      "command": "go build ./...",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": ["$go"],
      "group": "build"
    },
    {
      "label": "Kano: test",
      "type": "shell",
      "command": "go test ./internal/...",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "group": "test"
    }
  ]
}
