{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kano",
  "compatibility_date": "2026-02-24",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/solid-start/server-entry",
  "workers_dev": true,
  "preview_urls": true,
  "routes": [{ "pattern": "kano.sh", "custom_domain": true }],
  "keep_vars": true
}
